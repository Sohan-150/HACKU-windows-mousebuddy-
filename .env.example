# TypeSafe jev: the fast, cheap decider for every step, and the planner (with rules) when there is no Claude key.
TYPESAFE_API_KEY=
# Claude (optional): plans open-ended tasks, takes over steps jev is unsure about, writes text nobody planned,
# checks results, and runs explain mode (answers about your screen, drawn on it, and "how do I" lessons).
ANTHROPIC_API_KEY=
# ElevenLabs (optional): a natural voice for the answers. Free plan: 10,000 credits a month (about 20,000 characters
# spoken). Create a key at https://elevenlabs.io/app/settings/api-keys (Text to Speech access is enough).
# Without it, or when the credits run low, answers use the Windows voice.
ELEVENLABS_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5   # default; claude-haiku-4-5 is cheaper
# TYPESAFE_MODEL=jev-1.13.0
# REGION=HK            # two-letter country for maps and flights, so "Central" means Central, Hong Kong (Google guesses from the IP otherwise)
# CURRENCY=HKD         # currency for flight prices
# DRIVER=cua           # cua (real background agent) | sim (simulated desktop, for trying the panel without Cua)
# PANEL_PORT=3000
# VOICE=on             # on | off
# VOICE_MODE=run       # run: a spoken instruction runs at once | draft: it goes in the box and waits for Run
# PTT_KEY=ctrl_win     # hold to talk: ctrl_win (default) | ctrl_alt | ctrl_shift | ctrl | right_ctrl | right_alt | f8 | f9
#                      (Fn cannot be used: the keyboard handles it and Windows never sees it)
# VOICE_LANG=en        # spoken language (en), or auto
# WHISPER_MODEL=small.en  # Windows speech model: small.en for English (default), small for other languages;
#                         about 2.5 s per 8 s clip on this laptop; medium.en hears better and is about 3x slower
# VOICE_WORDS=Mohit, Dua Lipa   # names you say (friends, artists, apps): spelled right, and misheard ones corrected
# VOICE_CONFIRM=auto   # auto: a job heard unsurely is said back and waits for "yes" | always | off
# VOICE_BEAM=5         # speech beam search width (1 = fastest, more mishearings)
# ELEVENLABS_VOICE=Xb7hH8MSUJpSbSDYk0k2   # the ElevenLabs voice (default: Alice, clear British English)
# VOICE_OUT=elevenlabs # elevenlabs (when a key is set) | system: always the Windows voice
# OVERLAY=on           # the on-screen buddy, drawings, agents' widgets and typing box (off: answers spoken only)
# FAST_INPUT=on        # presses and text straight through UI Automation (off: everything through Cua)
# SPEAK=on             # with OVERLAY=off: read answers aloud with the Windows voice
# CLAUDE_BUDGET_USD=1  # Claude spending cap per run of the app; after it, jev + rules only
