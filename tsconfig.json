{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "types": ["bun"],
    "lib": ["ESNext", "DOM"]
  },
  "include": ["src", "testsite", "tests", "scripts"]
}
